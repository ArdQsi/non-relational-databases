{
  "uid": "opensearch-lab2",
  "title": "OpenSearch - состояние и производительность",
  "tags": [
    "opensearch",
    "lab2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
