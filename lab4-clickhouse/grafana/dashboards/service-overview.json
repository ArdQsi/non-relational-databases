          "rawSql": "SELECT service, endpoint, count() AS requests, round(avg(duration_ms), 1) AS avg_ms, quantile(0.95)(duration_ms) AS p95_ms, round(100 * countIf(status >= 500) / count(), 2) AS err_pct FROM monitoring.service_events WHERE $__timeFilter(timestamp) AND service IN ($service) GROUP BY service, endpoint ORDER BY p95_ms DESC LIMIT 10",
