          "editorType": "sql",
          "format": 2,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, service, count() / $__interval_s AS rps FROM monitoring.service_events WHERE $__timeFilter(timestamp) AND service IN ($service) GROUP BY time, service ORDER BY time",
